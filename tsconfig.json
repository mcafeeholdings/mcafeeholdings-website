{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "noEmit": true,
    "outDir": "./build",
    "paths": {
      "assets/*": ["src/assets/*"],
      "client/*": ["src/client/*"],
      "common/*": ["src/common/*"],
      "server/*": ["src/server/*"]
    },
    "resolveJsonModule": true,
    "strict": true,
    "target": "es2025",
    "types": ["node"]
  },
  "exclude": ["node_modules"],
  "include": ["./src/**/*"],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}

{
  "author": "Sebastian Sereno",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "type-enum": [
      "build",
      "chore",
      "ci",
      "docs",
      "feat",
      "fix",
      "patch",
      "perf",
      "refactor",
      "revert",
      "style",
      "test"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "lefthook": "^2.1.12",
    "nodemon": "^3.1.14",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "license": "All Rights Reserved",
  "main": "src/server/index.ts",
  "name": "McAfee-Holdings",
  "nodemonConfig": {
    "exec": "tsx -r tsconfig-paths/register -r dotenv/config ./src/server/index.ts",
    "ext": "ts,json",
    "ignore": [
      "src/**/*.spec.ts",
      "src/client/**"
    ],
    "watch": [
      "src"
    ]
  },
  "private": true,
  "repository": "https://github.com/mcafeeholdings/website.git",
  "scripts": {
    "dev": "nodemon"
  },
  "version": "1.0.0"
}
